# 경량 배포용 이미지 — 로컬 모델(torch/sentence-transformers)과 chromadb를 설치하지 않는다.
# 질의 임베딩은 HF Inference API가 담당하고, 벡터는 numpy 인덱스를 쓴다.
#
# 빌드:
#   docker build -f Dockerfile.slim -t bible-search-slim .
# 실행(데이터/인덱스는 볼륨 마운트):
#   docker run --rm -p 8000:8000 --memory=512m \
#     -e BIBLE_API_KEY=... -e HF_TOKEN=... \
#     -v "$PWD/data:/app/data" -v "$PWD/numpy_index:/app/numpy_index" \
#     -v "$PWD/token_cache.json:/app/token_cache.json" \
#     bible-search-slim
FROM python:3.12-slim

WORKDIR /app

# 경량 의존성만 설치 (torch, sentence-transformers, chromadb 제외)
RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.29" \
    "pydantic-settings>=2.2" \
    "numpy>=1.26" \
    "rank-bm25>=0.2.2" \
    "kiwipiepy>=0.17" \
    "huggingface_hub>=0.34"

COPY src ./src

ENV PYTHONPATH=/app/src \
    BIBLE_DATA_PATH=/app/data/verses.jsonl \
    BIBLE_NUMPY_INDEX_PATH=/app/numpy_index \
    BIBLE_TOKEN_CACHE_PATH=/app/token_cache.json \
    BIBLE_EMBEDDER=hf \
    BIBLE_VECTOR_STORE=numpy \
    BIBLE_USE_TOKEN_CACHE=true

EXPOSE 8000
CMD ["uvicorn", "bible_search.api:app", "--host", "0.0.0.0", "--port", "8000"]
