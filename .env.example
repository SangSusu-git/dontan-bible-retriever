BIBLE_API_KEY=change-me
BIBLE_DATA_PATH=data/verses.jsonl
BIBLE_CHROMA_PATH=chroma
BIBLE_CHROMA_COLLECTION=verses
# 벡터 저장소 선택: chroma(기존) | numpy(경량 배포용, chromadb 불필요)
BIBLE_VECTOR_STORE=chroma
BIBLE_NUMPY_INDEX_PATH=numpy_index
# 임베더 선택: local(로컬 모델, 기본값, 2.1GB 다운로드 필요) | hf(HF Inference API, 로컬 모델 불필요)
BIBLE_EMBEDDER=local
# BIBLE_EMBEDDER=hf 사용 시 필요한 토큰 (미설정 시 HF_TOKEN 환경변수를 사용)
# BIBLE_HF_TOKEN=hf_xxx
BIBLE_DENSE_THRESHOLD=0.7
BIBLE_RRF_K=60
BIBLE_MAX_RESULTS=50
BIBLE_BM25_TOP_K=30
# 사전 토큰화 캐시로 기동 시간 단축 (형태소 분석 결과를 파일로 캐싱)
BIBLE_USE_TOKEN_CACHE=false
BIBLE_TOKEN_CACHE_PATH=token_cache.json
# 형태소 분석기 선택: kiwi(기본값) | mecab(메모리 1/20 수준(약 24MB),
# 낯선 구절 검색 품질 우수 — 단, 토크나이저를 바꾸면 토큰 캐시 재생성 필요
BIBLE_TOKENIZER=kiwi
