BIBLE_API_KEY=change-me
BIBLE_DATA_PATH=data/verses.jsonl
BIBLE_CHROMA_PATH=chroma
BIBLE_CHROMA_COLLECTION=verses
# 벡터 저장소 선택: chroma(기존) | numpy(경량 배포용, chromadb 불필요)
BIBLE_VECTOR_STORE=chroma
BIBLE_NUMPY_INDEX_PATH=numpy_index
# numpy 인덱스 빌드 시(scripts/build_numpy_index.py)에만 쓰이는 SVD 차원 축소 목표.
# 빈 값이면 전체 차원(축소 없음); 384 권장 — 메모리 121MB→45MB, 품질 동일(측정됨)
BIBLE_NUMPY_INDEX_DIM=
# 임베더 선택: local(로컬 모델, 기본값, 2.1GB 다운로드 필요) | hf(HF Inference API, 로컬 모델 불필요)
BIBLE_EMBEDDER=local
# BIBLE_EMBEDDER=hf 사용 시 필요한 토큰 (미설정 시 HF_TOKEN 환경변수를 사용)
# BIBLE_HF_TOKEN=hf_xxx
BIBLE_DENSE_THRESHOLD=0.7
BIBLE_RRF_K=60
BIBLE_MAX_RESULTS=50
# BM25 후보 풀 크기(최종 노출 개수 아님). 정규화 가중합 융합의 재랭킹 여지를
# 넓히려고 100으로 잡음(실험 근거: scripts/experiment_ranking.py, config C8)
BIBLE_BM25_TOP_K=100
# 사전 토큰화 캐시로 기동 시간 단축 (형태소 분석 결과를 파일로 캐싱)
BIBLE_USE_TOKEN_CACHE=false
BIBLE_TOKEN_CACHE_PATH=token_cache.json
# 형태소 분석기 선택: kiwi(기본값) | mecab(메모리 1/20 수준(약 24MB),
# 낯선 구절 검색 품질 우수 — 단, 토크나이저를 바꾸면 토큰 캐시 재생성 필요
BIBLE_TOKENIZER=kiwi

# --- 랭킹 융합(실험 검증된 기본값: scripts/experiment_ranking.py "C8") ---
# 183개 평가 질의 MRR 0.674→0.928, 284개 강건성 세트에서 McNemar 회귀 0건/개선 30건.
# 융합 방식: weighted(정규화 가중합, 기본값) | rrf(기존 Reciprocal Rank Fusion)
BIBLE_FUSION=weighted
# BM25 길이 정규화 b. rank_bm25 기본값 0.75보다 완화 — 균질하게 짧은 성경 구절
# 코퍼스에서는 과도한 길이 정규화가 오히려 해가 됨(실험으로 확인됨).
BIBLE_BM25_B=0.4
# weighted 융합에서만 쓰이는 채널별 가중치. 커버리지(질의어 충족률) 신호를
# 크게 반영하는 것이 이번 개선의 핵심이다.
BIBLE_W_BM25=0.7
BIBLE_W_DENSE=1.0
BIBLE_W_COV=2.0
BIBLE_W_PROX=0.5
